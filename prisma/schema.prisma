generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  SUPER_ADMIN
  ADMIN
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  SKIPPED
  CANCELLED
  NO_SHOW
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FeatureKey {
  QR_QUEUE
  BOOKING
  WHATSAPP
  TV_DISPLAY
  VOICE_CALL
  MULTI_COUNTER
  ANALYTICS
  ADVERTISEMENT
  MULTI_BRANCH
}

enum AccessTokenType {
  QR_QUEUE
  QUEUE_STATUS
  BOOKING
  DISPLAY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Business {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  businessType  String                 @default("GENERAL")
  timezone      String                 @default("Asia/Jakarta")
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  branches      Branch[]
  services      Service[]
  memberships   BusinessMembership[]
  features      FeatureConfiguration[]
  customers     Customer[]
  queues        Queue[]
  bookings      Booking[]
  notifications Notification[]
  displays      Display[]
  accessTokens  AccessToken[]
  auditLogs     AuditLog[]
}

model Branch {
  id             String                  @id @default(cuid())
  businessId     String
  name           String
  slug           String
  timezone       String?
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  counters       Counter[]
  queues         Queue[]
  bookings       Booking[]
  operatingHours OperatingHours[]
  queueConfig    QueueConfiguration?
  displays       Display[]
  accessTokens   AccessToken[]
  scopes         MembershipBranchScope[]
  sequences      QueueSequence[]
  bookingSlots   BookingSlot[]

  @@unique([businessId, slug])
  @@index([businessId, active])
}

model User {
  id            String               @id @default(cuid())
  name          String?
  email         String?              @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  accounts      Account[]
  sessions      Session[]
  memberships   BusinessMembership[]
  queueHistory  QueueHistory[]
  auditLogs     AuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model BusinessMembership {
  id            String                  @id @default(cuid())
  userId        String
  businessId    String
  role          MembershipRole
  createdAt     DateTime                @default(now())
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  business      Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchScopes  MembershipBranchScope[]
  counterScopes CounterMember[]

  @@unique([userId, businessId])
  @@index([businessId, role])
}

model MembershipBranchScope {
  membershipId String
  branchId     String
  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId])
}

model Service {
  id              String           @id @default(cuid())
  businessId      String
  name            String
  code            String
  description     String?          @db.VarChar(500)
  averageMinutes  Int              @default(10)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  counterServices CounterService[]
  queues          Queue[]
  bookings        Booking[]
  bookingSlots    BookingSlot[]
  accessTokens    AccessToken[]
  sequences       QueueSequence[]

  @@unique([businessId, code])
  @@index([businessId, active])
}

model Counter {
  id             String           @id @default(cuid())
  branchId       String
  name           String
  code           String
  active         Boolean          @default(true)
  activeQueueId  String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  services       CounterService[]
  members        CounterMember[]
  displayedOn    DisplayCounter[]
  activeQueue    Queue?           @relation("ActiveQueue", fields: [activeQueueId], references: [id], onDelete: SetNull)
  assignedQueues Queue[]          @relation("AssignedCounter")
  history        QueueHistory[]

  @@unique([branchId, code])
  @@index([branchId, active])
}

/// Which operator is allowed to work a given counter. A user with no row here
/// is unrestricted, so existing accounts keep working after this migration.
model CounterMember {
  counterId    String
  membershipId String
  createdAt    DateTime           @default(now())
  counter      Counter            @relation(fields: [counterId], references: [id], onDelete: Cascade)
  membership   BusinessMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([counterId, membershipId])
  @@index([membershipId])
}

/// Which counters a TV display shows. No rows means every counter in the
/// branch, which is what a lobby screen normally wants.
model DisplayCounter {
  displayId String
  counterId String
  display   Display @relation(fields: [displayId], references: [id], onDelete: Cascade)
  counter   Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)

  @@id([displayId, counterId])
  @@index([counterId])
}

model CounterService {
  counterId String
  serviceId String
  counter   Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([counterId, serviceId])
  @@index([serviceId])
}

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  name          String
  phone         String?
  email         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  queues        Queue[]
  bookings      Booking[]
  notifications Notification[]

  @@index([businessId, phone])
  @@index([businessId, email])
}

model Queue {
  id                String         @id @default(cuid())
  businessId        String
  branchId          String
  serviceId         String
  customerId        String?
  bookingId         String?        @unique
  counterId         String?
  serviceDate       DateTime       @db.Date
  sequenceNumber    Int
  ticketNumber      String
  status            QueueStatus    @default(WAITING)
  issuedAt          DateTime       @default(now())
  calledAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  version           Int            @default(0)
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service           Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  booking           Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  counter           Counter?       @relation("AssignedCounter", fields: [counterId], references: [id], onDelete: SetNull)
  activeAt          Counter?       @relation("ActiveQueue")
  history           QueueHistory[]
  statusAccessToken AccessToken?

  @@unique([branchId, serviceId, serviceDate, sequenceNumber])
  @@index([businessId, branchId, serviceDate, status, issuedAt])
  @@index([serviceId, serviceDate, status])
  @@index([counterId, status])
}

model QueueSequence {
  id          String   @id @default(cuid())
  branchId    String
  serviceId   String
  serviceDate DateTime @db.Date
  lastNumber  Int      @default(0)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceId, serviceDate])
}

model QueueHistory {
  id          String       @id @default(cuid())
  queueId     String
  actorUserId String?
  counterId   String?
  fromStatus  QueueStatus?
  toStatus    QueueStatus
  action      String
  metadata    Json?
  createdAt   DateTime     @default(now())
  queue       Queue        @relation(fields: [queueId], references: [id], onDelete: Restrict)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  counter     Counter?     @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([queueId, createdAt])
  @@index([actorUserId, createdAt])
}

model Booking {
  id                String        @id @default(cuid())
  businessId        String
  branchId          String
  serviceId         String
  customerId        String
  scheduledAt       DateTime
  status            BookingStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  service           Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  queue             Queue?
  slot              BookingSlot?
  statusAccessToken AccessToken?

  @@index([branchId, scheduledAt, status])
  @@index([businessId, scheduledAt])
}

model BookingSlot {
  id        String   @id @default(cuid())
  branchId  String
  serviceId String
  startsAt  DateTime
  bookingId String?  @unique
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([branchId, serviceId, startsAt])
  @@index([branchId, startsAt, bookingId])
}

model Notification {
  id         String             @id @default(cuid())
  businessId String
  customerId String?
  channel    String
  provider   String
  status     NotificationStatus @default(PENDING)
  recipient  String?
  payload    Json?
  errorCode  String?
  attempts   Int                @default(0)
  sentAt     DateTime?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId, status, createdAt])
}

model Display {
  id         String           @id @default(cuid())
  businessId String
  branchId   String
  name       String
  tokenHash  String           @unique
  active     Boolean          @default(true)
  config     Json?
  createdAt  DateTime         @default(now())
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  counters   DisplayCounter[]

  @@index([branchId, active])
}

model AccessToken {
  id         String          @id @default(cuid())
  businessId String
  branchId   String?
  serviceId  String?
  queueId    String?         @unique
  bookingId  String?         @unique
  tokenHash  String          @unique
  type       AccessTokenType
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service    Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  queue      Queue?          @relation(fields: [queueId], references: [id], onDelete: Cascade)
  booking    Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([businessId, type, revokedAt])
}

model FeatureConfiguration {
  id         String     @id @default(cuid())
  businessId String
  featureKey FeatureKey
  enabled    Boolean    @default(false)
  config     Json?
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, featureKey])
}

model OperatingHours {
  id       String  @id @default(cuid())
  branchId String
  weekday  Int
  opensAt  String
  closesAt String
  closed   Boolean @default(false)
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday])
}

model QueueConfiguration {
  id             String  @id @default(cuid())
  branchId       String  @unique
  ticketPrefix   String  @default("Q")
  resetDaily     Boolean @default(true)
  estimateBuffer Int     @default(0)
  branch         Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String
  actorUserId String?
  branchId    String?
  action      String
  targetType  String
  targetId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  businessId  String?
  branchId    String?
  eventType   String
  aggregateId String
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, availableAt])
  @@index([branchId, createdAt])
  @@index([aggregateId, createdAt])
}

model RateLimitBucket {
  key           String   @id @db.VarChar(64)
  windowStarted DateTime
  count         Int      @default(0)

  @@index([windowStarted])
}
