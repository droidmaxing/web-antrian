# Base URL aplikasi. WAJIB diisi untuk setiap environment (dev/staging/produksi).
# Sumber utama untuk redirect, callback auth, QR/link publik, dan tautan display.
# Kosongkan hanya bila reverse proxy sudah mengirim X-Forwarded-Host/Proto.
# Contoh dev:       http://localhost:3000
# Contoh produksi:  https://antrian.perusahaan.com
APP_URL=
# Nilai yang sama, di-inline ke bundle klien saat build.
NEXT_PUBLIC_APP_URL=
# Opsional: paksa skema protokol bila reverse proxy tidak mengirim X-Forwarded-Proto.
APP_PROTOCOL=

DATABASE_URL="mysql://queue_user:***@localhost:3306/queue_management"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_TRUST_HOST="true"
