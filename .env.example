# Template .env untuk web-antrian. Copy: cp .env.example .env  (file .env di-gitignore)
# Compose WAJIB dijalankan dengan .env ini.
MYSQL_ROOT_PASSWORD=ubah-root-pass
MYSQL_PASSWORD=ubah-pass-app
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
AUTH_TRUST_HOST=true

# Alamat publik app. WAJIB diisi: dipakai untuk link QR/antrean & redirect auth.
# LAN   : http://192.168.100.209:3000
# Produksi: https://antrian.perusahaan.com
APP_URL=http://192.168.100.209:3000
APP_PROTOCOL=http

# Untuk `npm run dev` di host (port host MySQL saat compose jalan).
DATABASE_URL="mysql://queue_user:***@127.0.0.1:3307/queue_management"

# Google OAuth (opsional — abaikan jika tidak perlu login Google).
# Daftar app di https://console.cloud.google.com, redirect URI: http://APP_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
